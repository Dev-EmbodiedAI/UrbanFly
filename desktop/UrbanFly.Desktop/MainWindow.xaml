<Window x:Class="UrbanFly.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="UrbanFly · 城市低空数字孪生"
        Width="1440"
        Height="900"
        MinWidth="1100"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackground}"
        Foreground="{StaticResource AppText}">
  <Grid x:Name="RootGrid">
    <wv2:WebView2 x:Name="TwinView" DefaultBackgroundColor="#061016" />

    <Border x:Name="StartupOverlay"
            Background="#F2061016"
            Visibility="Visible">
      <StackPanel HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Width="420">
        <Border Width="58" Height="58"
                HorizontalAlignment="Center"
                CornerRadius="15"
                BorderBrush="#6072E0AE"
                BorderThickness="1"
                Background="#1872E0AE">
          <TextBlock Text="U"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     FontSize="24"
                     FontWeight="Bold"
                     Foreground="#DFFFEF" />
        </Border>
        <TextBlock Text="URBANFLY DIGITAL TWIN"
                   Margin="0,22,0,7"
                   HorizontalAlignment="Center"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Foreground="#F0F6F7" />
        <TextBlock x:Name="StartupStatus"
                   Text="正在启动本地实时引擎…"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   FontSize="12"
                   Foreground="#9EB0B6" />
        <ProgressBar Height="3"
                     Margin="0,20,0,0"
                     IsIndeterminate="True"
                     Foreground="#72E0AE"
                     Background="#182A32" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
